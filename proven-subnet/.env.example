# Azure OpenAI settings for AI-backed Proven miners.
# Copy this file to .env locally and fill in real values there.
# Never commit real API keys.

# Full Azure chat completions deployment URI. If set, the miner can derive
# AZURE_OPENAI_ENDPOINT, AZURE_OPENAI_DEPLOYMENT, and AZURE_OPENAI_API_VERSION.
AZURE_OPENAI_TARGET_URI=https://<resource>.cognitiveservices.azure.com/openai/deployments/<deployment>/chat/completions?api-version=2025-01-01-preview

# Required unless your runtime injects AZURE_OPENAI_KEY instead.
AZURE_OPENAI_API_KEY=<your-rotated-api-key>

# Optional separate configuration. These override values parsed from
# AZURE_OPENAI_TARGET_URI when present.
AZURE_OPENAI_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Optional generation tuning.
AZURE_OPENAI_TEMPERATURE=0.2
AZURE_OPENAI_TOP_P=1.0
AZURE_OPENAI_MAX_COMPLETION_TOKENS=4096
